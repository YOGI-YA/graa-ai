# ==============================================================================
# Graa AI Environment Configuration
# ==============================================================================

# PostgreSQL Database (Neon DB, AWS RDS PostgreSQL, or Docker PostgreSQL)
DATABASE_URL="postgresql://user:password@your-db-host:5432/graaai?sslmode=require"

# NextAuth Authentication
NEXTAUTH_SECRET="generate-a-random-32-byte-hex-string-for-production"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="https://graaai.vercel.app"

# Groq AI Inference (Primary ultra-fast inference with multi-key rotation)
GROQ_API_KEY_1="gsk_your_primary_groq_api_key"
GROQ_API_KEY_2="gsk_your_secondary_groq_api_key"
GROQ_API_KEY_3="gsk_your_tertiary_groq_api_key"
GROQ_MODEL="openai/gpt-oss-120b"

# NVIDIA NIM / Vision AI (Secondary failover & image OCR)
NVIDIA_API_KEY="nvapi-your_nvidia_api_key"
NVIDIA_MODEL="meta/llama-3.2-11b-vision-instruct"

# Vector Embeddings (Jina AI for semantic search & RAG with key rotation)
EMBEDDINGS_API_URL="https://api.jina.ai/v1/embeddings"
EMBEDDINGS_API_KEY="jina_your_primary_jina_key"
EMBEDDINGS_API_KEY_1="jina_your_primary_jina_key"
EMBEDDINGS_API_KEY_2="jina_your_secondary_jina_key"
EMBEDDINGS_API_KEY_3="jina_your_tertiary_jina_key"
EMBEDDINGS_MODEL="jina-embeddings-v3"
EMBEDDING_DIM="384"

# Optional: Code Execution Sandbox (Piston endpoint, leave empty to use Paiza.io)
PISTON_URL=""

# Optional: Google OAuth (Leave empty to use credentials login only)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional: Heavy PDF extractor microservice (not required; native extraction active)
PDF_EXTRACTOR_SERVICE_URL=""

# ==============================================================================
# GRAA AI - AWS Production Environment Configuration
# ==============================================================================

# PostgreSQL Database (Neon DB or AWS RDS PostgreSQL)
DATABASE_URL="postgresql://user:password@your-db-host:5432/graaai?sslmode=require"

# NextAuth Authentication
NEXTAUTH_SECRET="generate-a-random-32-byte-hex-string-for-production"
NEXTAUTH_URL="https://your-domain.com"
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Groq AI Inference (Primary fast roadmap & quiz generation)
GROQ_API_KEY_1="gsk_your_groq_api_key_here"
GROQ_MODEL="qwen/qwen3.8-27b"

# NVIDIA NIM / Vision AI (Fallback & image OCR)
NVIDIA_API_KEY="nvapi-your_nvidia_key_here"
NVIDIA_MODEL="meta/llama-3.2-11b-vision-instruct"

# Vector Embeddings (Jina AI for semantic search / RAG)
EMBEDDINGS_API_URL="https://api.jina.ai/v1/embeddings"
EMBEDDINGS_API_KEY_1="jina_your_jina_key_here"
EMBEDDINGS_MODEL="jina-embeddings-v3"
EMBEDDING_DIM="384"

# Optional: Code Execution Sandbox (Piston endpoint, leave empty for Paiza.io fallback)
PISTON_URL=""

# Optional: Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

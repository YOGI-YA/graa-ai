{
  "name": "graa-document-extractor",
  "version": "1.0.0",
  "description": "High-performance, scalable Fastify TypeScript microservice for extracting syllabus and curriculum documents (PDF, DOCX, TXT).",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "keywords": [
    "pdf",
    "extractor",
    "syllabus",
    "curriculum",
    "fastify",
    "typescript"
  ],
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "mammoth": "^1.9.0",
    "pdf-parse": "^1.1.1",
    "unpdf": "^0.12.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
